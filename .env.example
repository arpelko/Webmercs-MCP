# Webmercs Admin API uses HTTP Basic Auth.
# Enter the username and password provided by Webmercs.
# Do not put a Base64 encoded Authorization header into these fields.
WEBMERCS_API_USERNAME=
WEBMERCS_API_PASSWORD=

# Request timeout in seconds (positive number, at most 120).
WEBMERCS_TIMEOUT_SECONDS=30

# Required: your Webmercs project ID (a positive integer).
# The application sends this value as X-Project-ID with every API request.
# Example only: WEBMERCS_PROJECT_ID=123
WEBMERCS_PROJECT_ID=

# Tool package: readonly (default), orders, catalog, customers, full, none.
MCP_TOOL_PACKAGE=readonly

# Writes always default to dry_run=true. Actual execution also needs this gate.
WEBMERCS_ALLOW_WRITES=false

# Optional comma-separated exclusions, enforced for discovery and execution.
# Example: send_order_email,delete_order_line,generate_password_reset_link
MCP_DISABLED_TOOLS=
